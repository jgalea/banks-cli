#!/usr/bin/env python3
"""Read-only view of your own bank accounts through Enable Banking.

Uses Enable Banking's free restricted mode: you register one application,
link your own banks to it, and only those accounts come back. Nothing here
can move money; the API calls are account information only."""

import argparse
import json
import os
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid
import webbrowser
from datetime import date, datetime, timedelta, timezone

import jwt

API = "https://api.enablebanking.com"
HOME = os.path.expanduser("~/.config/banks")
CONFIG = os.path.join(HOME, "config.json")
KEY = os.path.join(HOME, "private.pem")
SESSIONS = os.path.join(HOME, "sessions.json")


def load(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except FileNotFoundError:
        return default


def save(path, data):
    os.makedirs(HOME, mode=0o700, exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def config():
    cfg = load(CONFIG, None)
    if not cfg or not os.path.exists(KEY):
        sys.exit("Not set up yet. Run: banks setup <application-id> <path-to-private.pem>")
    return cfg


def token(cfg):
    iat = int(datetime.now(timezone.utc).timestamp())
    with open(KEY) as f:
        key = f.read()
    return jwt.encode(
        {"iss": "enablebanking.com", "aud": "api.enablebanking.com", "iat": iat, "exp": iat + 3600},
        key,
        algorithm="RS256",
        headers={"kid": cfg["app_id"]},
    )


class ApiError(Exception):
    pass


def call(method, path, body=None, params=None, soft=False):
    cfg = config()
    url = API + path
    if params:
        url += "?" + urllib.parse.urlencode({k: v for k, v in params.items() if v is not None})
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Authorization", "Bearer " + token(cfg))
    req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        detail = e.read().decode(errors="replace")[:500]
        if soft:
            raise ApiError(f"HTTP {e.code} {detail}") from None
        sys.exit(f"{method} {path} failed: HTTP {e.code} {detail}")


def out(data, args, text):
    if args.json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
    else:
        text(data)


def cmd_setup(args):
    os.makedirs(HOME, mode=0o700, exist_ok=True)
    src = os.path.realpath(os.path.expanduser(args.pem))
    if src != os.path.realpath(KEY):
        shutil.copyfile(src, KEY)
    os.chmod(KEY, 0o600)
    cfg = load(CONFIG, {})
    cfg["app_id"] = args.app_id
    cfg["redirect_url"] = args.redirect
    save(CONFIG, cfg)
    print(f"Saved. Key at {KEY}, redirect {args.redirect}.")
    print("The redirect URL must match one registered on the application in the Enable Banking control panel.")


def cmd_banks(args):
    res = call("GET", "/aspsps", params={"country": args.country.upper(), "psu_type": "personal"})
    hits = [a for a in res.get("aspsps", []) if not args.query or args.query.lower() in a["name"].lower()]

    def show(rows):
        for a in rows:
            days = (a.get("maximum_consent_validity") or 0) // 86400
            beta = " (beta)" if a.get("beta") else ""
            print(f"{a['name']}  [{a['country']}]  consent up to {days}d{beta}")
        if not rows:
            print("No match.")

    out(hits, args, show)


def cmd_link(args):
    cfg = config()
    country = args.country.upper()
    listing = call("GET", "/aspsps", params={"country": country, "psu_type": "personal"}).get("aspsps", [])
    match = [a for a in listing if a["name"].lower() == args.bank.lower()]
    if not match:
        sys.exit(f"No bank named '{args.bank}' in {country}. Try: banks banks {country} <part-of-name>")
    aspsp = match[0]
    seconds = aspsp.get("maximum_consent_validity") or 90 * 86400
    valid_until = datetime.now(timezone.utc) + timedelta(seconds=seconds - 3600)
    state = str(uuid.uuid4())
    start = call("POST", "/auth", body={
        "access": {"valid_until": valid_until.isoformat()},
        "aspsp": {"name": aspsp["name"], "country": country},
        "state": state,
        "redirect_url": cfg["redirect_url"],
        "psu_type": "personal",
    })
    print("Approve access in the browser window that just opened.")
    print("When the bank sends you back, the page may fail to load. That's fine:")
    print("copy the full address from the address bar (Cmd+L, Cmd+C).", flush=True)
    if args.no_browser:
        print(start["url"], flush=True)
    else:
        webbrowser.open(start["url"])
    pasted = wait_for_redirect(state)
    q = urllib.parse.parse_qs(urllib.parse.urlparse(pasted).query)
    if q.get("state", [state])[0] != state:
        sys.exit("State mismatch, so this URL isn't from the request just made. Nothing saved.")
    if "code" not in q:
        sys.exit(f"No code in that URL. Error from bank: {q.get('error', ['none'])[0]}")
    save_session(call("POST", "/sessions", body={"code": q["code"][0]}), valid_until.isoformat())


def save_session(session, fallback_valid_until=None):
    sessions = load(SESSIONS, {})
    aspsp = session.get("aspsp", {})
    valid_until = session.get("access", {}).get("valid_until", fallback_valid_until)
    sessions[session["session_id"]] = {
        "bank": aspsp.get("name"),
        "country": aspsp.get("country"),
        "valid_until": valid_until,
        "accounts": [
            {"uid": a["uid"], "name": a.get("name") or a.get("product") or "", "currency": a.get("currency"),
             "iban": (a.get("account_id") or {}).get("iban")}
            for a in session.get("accounts", [])
        ],
    }
    save(SESSIONS, sessions)
    if not session.get("accounts"):
        print("The bank returned no accounts. In restricted mode, link this bank under 'Link accounts' "
              "in the Enable Banking control panel first, then run this again.")
    print(f"Linked {aspsp.get('name')}: {len(session.get('accounts', []))} account(s), valid until {(valid_until or '')[:10]}.")


def cmd_finish(args):
    q = urllib.parse.parse_qs(urllib.parse.urlparse(args.url).query)
    if "code" not in q:
        sys.exit(f"No code in that URL. Error from bank: {q.get('error', ['none'])[0]}")
    save_session(call("POST", "/sessions", body={"code": q["code"][0]}))


def wait_for_redirect(state, minutes=20):
    """Watch the clipboard for the redirect URL; fall back to a prompt off macOS."""
    if not shutil.which("pbpaste"):
        return input("Redirected URL: ").strip()
    print(f"Waiting up to {minutes} minutes for it on the clipboard...", flush=True)
    deadline = time.time() + minutes * 60
    while time.time() < deadline:
        clip = subprocess.run(["pbpaste"], capture_output=True, text=True, check=False).stdout.strip()
        if f"state={state}" in clip:
            return clip
        time.sleep(2)
    sys.exit("Timed out waiting for the redirect URL. Nothing saved.")


def accounts(filter_text=None):
    rows = []
    for sid, s in load(SESSIONS, {}).items():
        for a in s["accounts"]:
            label = f"{s['bank']} {a['name']} {a['currency'] or ''}".strip()
            if filter_text and filter_text.lower() not in label.lower():
                continue
            rows.append({**a, "bank": s["bank"], "session": sid, "valid_until": s["valid_until"], "label": label})
    if not rows:
        sys.exit("No linked accounts" + (f" matching '{filter_text}'" if filter_text else "") + ". Run: banks link <bank> <country>")
    return rows


def mask(iban):
    return f"{iban[:4]}…{iban[-4:]}" if iban else ""


def cmd_status(args):
    rows = accounts()
    today = datetime.now(timezone.utc)

    def show(rows):
        for r in rows:
            left = (datetime.fromisoformat(r["valid_until"].replace("Z", "+00:00")) - today).days
            flag = "  EXPIRED, run link again" if left < 0 else ("  renew soon" if left < 14 else "")
            print(f"{r['label']:<40} {mask(r['iban']):<12} {left:>4} days left{flag}")

    out(rows, args, show)


def pick_balance(balances):
    order = ["CLAV", "ITAV", "ITBD", "CLBD", "XPCD", "OTHR"]
    return min(balances, key=lambda b: order.index(b["balance_type"]) if b.get("balance_type") in order else 99)


def cmd_balances(args):
    result = []
    for a in accounts(args.account):
        try:
            res = call("GET", f"/accounts/{a['uid']}/balances", soft=True)
        except ApiError as e:
            note = "bank rate limit, try again tomorrow" if "RATE_LIMIT" in str(e) else str(e)[:80]
            result.append({"account": a["label"], "iban": a["iban"], "balances": [], "amount": None,
                           "currency": a["currency"], "type": None, "error": note})
            continue
        bals = res.get("balances", [])
        b = pick_balance(bals) if bals else None
        result.append({"account": a["label"], "iban": a["iban"], "balances": bals,
                       "amount": b["balance_amount"]["amount"] if b else None,
                       "currency": b["balance_amount"]["currency"] if b else a["currency"],
                       "type": b.get("balance_type") if b else None})

    def show(rows):
        totals = {}
        for r in rows:
            amt = r["amount"] if r["amount"] is not None else "n/a"
            print(f"{r['account']:<40} {amt:>14} {r['currency'] or ''}  ({r.get('error') or r['type'] or 'no balance'})")
            if r["amount"] is not None:
                totals[r["currency"]] = totals.get(r["currency"], 0) + float(r["amount"])
        if len(rows) > 1:
            print("-" * 60)
            for cur, total in sorted(totals.items()):
                print(f"{'Total':<40} {total:>14,.2f} {cur}")

    out(result, args, show)


def cmd_tx(args):
    since = (date.today() - timedelta(days=args.days)).isoformat()
    result = []
    for a in accounts(args.account):
        key = None
        while True:
            res = call("GET", f"/accounts/{a['uid']}/transactions",
                       params={"date_from": since, "continuation_key": key})
            for t in res.get("transactions", []):
                amount = float(t["transaction_amount"]["amount"])
                if t.get("credit_debit_indicator") == "DBIT":
                    amount = -amount
                other = (t.get("creditor") if amount < 0 else t.get("debtor")) or {}
                result.append({
                    "account": a["label"],
                    "date": t.get("booking_date") or t.get("value_date") or t.get("transaction_date"),
                    "amount": amount,
                    "currency": t["transaction_amount"]["currency"],
                    "counterparty": other.get("name") or "",
                    "description": " ".join(t.get("remittance_information") or []),
                    "status": t.get("status"),
                })
            key = res.get("continuation_key")
            if not key:
                break
    result.sort(key=lambda t: t["date"] or "", reverse=True)

    def show(rows):
        for t in rows:
            text = (t["counterparty"] or t["description"])[:45]
            print(f"{t['date'] or '':<10}  {t['amount']:>11,.2f} {t['currency']}  {text:<45}  {t['account']}")
        if not rows:
            print(f"No transactions since {since}.")

    out(result, args, show)


def cmd_unlink(args):
    sessions = load(SESSIONS, {})
    gone = [sid for sid, s in sessions.items() if args.bank.lower() in s["bank"].lower()]
    if not gone:
        sys.exit(f"No linked bank matching '{args.bank}'.")
    for sid in gone:
        call("DELETE", f"/sessions/{sid}")
        print(f"Revoked {sessions.pop(sid)['bank']}.")
    save(SESSIONS, sessions)


def main():
    p = argparse.ArgumentParser(description="Read-only balances and transactions across your banks (Enable Banking)")
    p.add_argument("--json", action="store_true", help="print JSON")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("setup", help="save the application id and private key")
    s.add_argument("app_id")
    s.add_argument("pem")
    s.add_argument("--redirect", default="https://localhost/",
                   help="must match the redirect URL registered on the application")
    s.set_defaults(fn=cmd_setup)

    s = sub.add_parser("banks", help="list banks available in a country")
    s.add_argument("country", help="two-letter code, e.g. PT, BE, LT, DE, MT")
    s.add_argument("query", nargs="?")
    s.set_defaults(fn=cmd_banks)

    s = sub.add_parser("link", help="approve access to a bank (opens the browser)")
    s.add_argument("bank", help="exact name from 'banks banks'")
    s.add_argument("country")
    s.add_argument("--no-browser", action="store_true", help="print the approval URL instead of opening it")
    s.set_defaults(fn=cmd_link)

    s = sub.add_parser("finish", help="complete a link from a redirect URL, e.g. after link timed out")
    s.add_argument("url")
    s.set_defaults(fn=cmd_finish)

    s = sub.add_parser("status", help="linked accounts and days until each consent expires")
    s.set_defaults(fn=cmd_status)

    s = sub.add_parser("balances", help="current balance of every linked account")
    s.add_argument("account", nargs="?", help="filter, e.g. wise")
    s.set_defaults(fn=cmd_balances)

    s = sub.add_parser("tx", help="transactions")
    s.add_argument("account", nargs="?", help="filter, e.g. activobank")
    s.add_argument("--days", type=int, default=30)
    s.set_defaults(fn=cmd_tx)

    s = sub.add_parser("unlink", help="revoke a bank's consent")
    s.add_argument("bank")
    s.set_defaults(fn=cmd_unlink)

    args = p.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
